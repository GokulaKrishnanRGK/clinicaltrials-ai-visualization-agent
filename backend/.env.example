# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# Logs go to stdout and logs/app.log (rotating 10 MB × 5 files)
LOG_LEVEL=INFO

# LLM fallback model (used if a prompt YAML has no model_preference set)
CLINICAL_TRIALS_LLM_MODEL=bedrock/global.anthropic.claude-sonnet-4-6

# AWS credentials for Bedrock
AWS_PROFILE=your-profile-name
AWS_DEFAULT_REGION=us-east-1
